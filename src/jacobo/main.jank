(ns jacobo.main
  (:require [jacobo.sketch :as sketch])
  (:include "raylib.h"))

(defn run-sketch!
  "Run the window on the calling (main) thread. Callbacks are invoked each frame."
  ([draw-frame! keep-running?]
   (run-sketch! draw-frame! keep-running? (fn [] nil)))
  ([draw-frame! keep-running? initialize!]
   (cpp/InitWindow sketch/width sketch/height "Jacobo")
   (cpp/SetTargetFPS 60)
   (try
     (initialize!)
     (while (and (keep-running?) (not (cpp/WindowShouldClose)))
       (cpp/BeginDrawing)
       (try
         (draw-frame!)
         (finally (cpp/EndDrawing))))
     (finally
       (cpp/CloseWindow)))))

(defn -main [& args]
  (if (= "--smoke" (first args))
    (do
      ;; Exercise a raylib symbol without requiring a graphics context.
      (cpp/SetTraceLogLevel 4)
      (println "Jacobo: jank + raylib linked successfully."))
    (let [state (atom nil)]
      (run-sketch! (fn [] (sketch/draw! @state)) (constantly true)
                   (fn [] (reset! state (sketch/initial-state)))))))
