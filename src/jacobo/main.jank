(ns jacobo.main
  (:require [jacobo.sketch :as sketch])
  (:include "raylib.h"))

(defn -main [& args]
  (if (= "--smoke" (first args))
    (do
      ;; Exercise a raylib symbol without requiring a graphics context.
      (cpp/SetTraceLogLevel 4)
      (println "Jacobo: jank + raylib linked successfully."))
    (do
      (cpp/InitWindow sketch/width sketch/height "Jacobo")
      (cpp/SetTargetFPS 60)
      (try
        (while (not (cpp/WindowShouldClose))
          (cpp/BeginDrawing)
          (sketch/draw!)
          (cpp/EndDrawing))
        (finally
          (cpp/CloseWindow))))))
