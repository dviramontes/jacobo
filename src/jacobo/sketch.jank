(ns jacobo.sketch
  (:include "raylib.h"))

(def width 720)
(def height 720)

(defn setup! []
  {:ink [120 2 225 255]
   :paper [10 2 23 255]
   :rows 22
   :columns 22
   :spacing 48
   :origin [24 24]
   :circle-radius 23.0
   :cluster-offset 12
   :cluster-radius 10.0
   :square-offset 19
   :square-width 44.0
   :square-height 44.0
   :stroke-width 22.0})

(defn draw! [state]
  (let [{:keys [ink paper rows columns spacing origin circle-radius
                cluster-offset cluster-radius square-offset square-width
                square-height stroke-width]} state
        [ir ig ib ia] ink
        [pr pg pb pa] paper
        [ox oy] origin
        ink (cpp/Color ir ig ib ia)
        paper (cpp/Color pr pg pb pa)]
    (cpp/ClearBackground paper)
    (doseq [row (range rows)
            col (range columns)]
      (let [x (+ ox (* col spacing))
            y (+ oy (* row spacing))
            motif (mod (+ (* row 7) (* col 11)) 37)]
        (cond
          (= motif 4)
          (cpp/DrawRectangleLinesEx
           (cpp/Rectangle (* 1.0 (- x square-offset))
                          (* 1.0 (- y square-offset))
                          square-width
                          ; TODO:
                          ; let's intrudice some variability here
                          ; every other render lets draw toggle between
                          ; 22.0 and 44.0
                          square-height)
           stroke-width
           ink)

          (< motif 6)
          (doseq [dy [(- cluster-offset) cluster-offset]
                  dx [(- cluster-offset) cluster-offset]]
            (cpp/DrawCircleLines (+ x dx) (+ y dy) cluster-radius ink))

          :else
          (cpp/DrawCircleLines x y circle-radius ink)))))
  nil)
