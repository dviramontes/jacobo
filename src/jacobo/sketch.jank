(ns jacobo.sketch
  (:include "raylib.h"))

(def width 720)
(def height 720)

(declare ring)

(defn initial-state []
  {:ink [120 2 225 255]
   :paper [10 2 23 255]
   :rows 22
   :columns 22
   :spacing 48
   :origin [24 24]
   :circle-radius 23.0
   :cluster-offset 12
   :cluster-radius 10.0
   :square-offset 22
   :square-width 44.0
   :square-height 44.0
   :stroke-width 4.7
   :seed 55})

(defn draw! [state]
  (let [{:keys [ink paper rows columns spacing origin circle-radius
                cluster-offset cluster-radius square-offset square-width
                square-height stroke-width seed]} state
        [ir ig ib ia] ink
        [pr pg pb pa] paper
        [ox oy] origin
        native-ink (cpp/Color ir ig ib ia)
        paper (cpp/Color pr pg pb pa)
        ; elapsed-seconds (cpp/GetTime)
        ; phase (int (* elapsed-seconds 2))
        ]
    (cpp/ClearBackground paper)
    (doseq [row (range rows)
            col (range columns)]
      (let [x (+ ox (* col spacing))
            y (+ oy (* row spacing))
            motif (mod (+ (* row 7) (* col 11)) 37)
            ;; random seed
            short? (even? (hash [seed row col]))
            ;; pulse
            ; short? (even? (+ phase row col))
            sw (if short? 22.0 square-width)
            sh (if short? 22.0 square-height)]
        (cond
          (= motif 4)
          (cpp/DrawRectangleLinesEx
           (cpp/Rectangle (* 1.0 (- x square-offset))
                          (* 1.0 (- y square-offset))
                          sw
                          sh)
           stroke-width
           native-ink)

          (< motif 6)
          (doseq [dy [(- cluster-offset) cluster-offset]
                  dx [(- cluster-offset) cluster-offset]]
            (ring (+ x dx) (+ y dy) cluster-radius stroke-width ink))

          :else
          (ring x y circle-radius stroke-width ink)))))
  nil)

(defn ring
  "Draw a circle outline centered on radius r, with width w and RGBA ink."
  [x y r w i]
  (let [[red green blue alpha] i
        half-width (/ w 2.0)]
    (cpp/DrawRing
     (cpp/Vector2 (* 1.0 x) (* 1.0 y))
     (max 0.0 (- r half-width))
     (+ r half-width)
     0.0
     360.0
     64
     (cpp/Color red green blue alpha)))
  nil)
